{
  "version": 1,
  "material": {
    "name": "AlphaGreen",
    "color": [
      0.025,
      0.8,
      0.12
    ],
    "roughness": 0.5,
    "surface": {
      "shader": "Shaders/Unlit.hlsl",
      "mode": "opaque",
